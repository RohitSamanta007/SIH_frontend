# =============================================================================
# Case Intelligence Gateway -- Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in real values before running the server.
# Never commit .env to version control (it is in .gitignore).
# =============================================================================


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# HTTP port the Express gateway listens on
PORT=5000

# Runtime environment: development | production | test
NODE_ENV=development


# -----------------------------------------------------------------------------
# Database (MongoDB)
# -----------------------------------------------------------------------------

# Full MongoDB connection string (Atlas or local).
# The gateway uses this for all case/entity/edge/pattern persistence.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# Alternative name accepted as a fallback (e.g. older tooling / docker-compose)
# MONGO_URI=mongodb://localhost:27017/case_intelligence


# -----------------------------------------------------------------------------
# AI Reasoning Service (reasoning-service / FastAPI)
# -----------------------------------------------------------------------------

# Base URL of the FastAPI reasoning core.
# Two environment variable names are accepted -- set either one:
#   FASTAPI_BASE_URL      -- traditional name used by the gateway
#   REASONING_SERVICE_URL -- deployment-friendly alias (e.g. Kubernetes service name)
# The gateway prefers FASTAPI_BASE_URL; falls back to REASONING_SERVICE_URL; then to the default below.
FASTAPI_BASE_URL=http://127.0.0.1:8000
# REASONING_SERVICE_URL=http://reasoning-service:8000  # Example: Docker/K8s service name

# HTTP request timeout in milliseconds for calls to the FastAPI reasoning service.
# Default: 60000 (60 s) -- Groq LLM inference on large inputs routinely takes 30-50 s.
# Increase this value if you observe FASTAPI_TIMEOUT errors with large CDR/FIR uploads.
FASTAPI_TIMEOUT_MS=60000

# Shared internal secret sent in the X-Internal-Secret header with every FastAPI request.
# Must match the GATEWAY_SHARED_SECRET env var set in reasoning-service/.env.
# Leave blank to disable header-based service auth (not recommended for production).
FASTAPI_INTERNAL_SECRET=replace_me_with_a_strong_random_secret


# -----------------------------------------------------------------------------
# Authentication & Security (JWT)
# -----------------------------------------------------------------------------

# Secret key used to sign and verify investigator JWT tokens.
# Use a cryptographically random string of at least 32 characters in production.
JWT_SECRET=replace_me_with_a_strong_random_jwt_secret

# Token expiry duration -- accepts any string valid for the jsonwebtoken library.
# Examples: 15m, 1h, 7d
JWT_EXPIRES_IN=15m


# -----------------------------------------------------------------------------
# Default Investigator Seed Account
# Change these before deploying -- the server seeds this account on first start.
# -----------------------------------------------------------------------------

DEFAULT_INVESTIGATOR_USERNAME=investigator
DEFAULT_INVESTIGATOR_PASSWORD=replace_me_with_a_strong_password
