# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/case_intelligence

# FastAPI AI Reasoning Engine (Argha's Service)
FASTAPI_BASE_URL=http://127.0.0.1:8000
FASTAPI_TIMEOUT_MS=30000
FASTAPI_INTERNAL_SECRET=optional_shared_service_secret

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=15m
